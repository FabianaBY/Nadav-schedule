        function addMinutesToTime(timeStr, deltaMinutes) {
            return minutesToTime(timeToMinutes(timeStr) + deltaMinutes);
        }

        function isFitnessActivity(activityType = '', location = '', note = '') {
            const combined = `${activityType} ${location} ${note}`;
            return /כושר/.test(combined);
        }

        function getArrivalOffsetMinutes(activityType = '', location = '', note = '') {
            return isFitnessActivity(activityType, location, note) ? 15 : 30;
        }

        function calculateArrivalTime(startTime, activityType = '', location = '', note = '') {
            const offset = getArrivalOffsetMinutes(activityType, location, note);
            return addMinutesToTime(startTime, -offset);
        }

        function calculateDefaultEndTime(startTime) {
            return addMinutesToTime(startTime, 90);
        }

        function detectGroupCohort(text) {
            if (/\b2010\b/.test(text)) return '2010';
            if (/\b2011\b/.test(text)) return '2011';
            if (/(?:פתח\s*תקוו?ה|פ["״׳']ת)/.test(text)) return 'pt';
            return null;
        }

        // ==========================================
        // מנוע פענוח טקסט חופשי (תומך בכותרות 2011 / 2010 / פתח תקווה)
        // ==========================================
        function parseAndBuild(append = false) {
            const rawText = document.getElementById('raw-text-input').value.trim();
            if (!rawText) {
                showToast('אנא הדביקי טקסט עם מועדי אימונים לפני הפענוח.', 'warning');
                return;
            }

            const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
            const parsedSessions = [];
            let currentDay = null;
            let activeCohort = null;

            const firstLineHasTime = /\b([01]?\d|2[0-3]):[0-5]\d\b/.test(lines[0]);
            const firstLineHasCohort = Boolean(detectGroupCohort(lines[0]));
            if (!firstLineHasTime && !firstLineHasCohort && lines[0].includes('שבוע')) {
                appState.weekTitle = lines[0].replace(/[:*]/g, '').trim();
                document.getElementById('week-title-input').value = appState.weekTitle;
            }

            for (let line of lines) {
                let cleanLine = line.replace(/[*_~•▪▫]/g, ' ').replace(/\s+/g, ' ').trim();

                const parsedTime = extractTimeFromLine(cleanLine);
                const startTime = parsedTime ? parsedTime.startTime : null;
                const endTime = parsedTime ? parsedTime.endTime : null;
                const matchedTimeStr = parsedTime ? parsedTime.matchedTimeStr : '';

                const lineCohort = detectGroupCohort(cleanLine);

                const detectedDay = extractDayOfWeek(cleanLine);
                if (detectedDay !== null) {
                    currentDay = detectedDay;
                }

                // זיהוי שורת כותרת של שנתון / קבוצה (כמו "2011", "2010" או "פתח תקווה") ללא שעה
                if (!startTime && lineCohort) {
                    activeCohort = lineCohort;
                    continue;
                }

                if (!startTime) {
                    continue;
                }

                const dayToUse = detectedDay !== null ? detectedDay : (currentDay !== null ? currentDay : 0);
                const cohortToUse = lineCohort || activeCohort || 'general';

                // זיהוי סוג פעילות (כולל אימון כושר)
                let activityType = 'אימון';
                if (/כושר/.test(cleanLine)) {
                    activityType = 'אימון כושר';
                } else if (/משחק|ליגה|גביע|ידידות/.test(cleanLine)) {
                    activityType = 'משחק';
                } else if (/טורניר/.test(cleanLine)) {
                    activityType = 'טורניר';
                }

                // חילוץ מיקום משארית הטקסט
                let locationText = cleanLine;
                if (matchedTimeStr) {
                    locationText = locationText.replace(matchedTimeStr, ' ');
                }
                locationText = locationText
                    .replace(/יום\s+(ראשון|שני|שלישי|רביעי|חמישי|שישי|שבת)/g, ' ')
                    .replace(/\b(ראשון|שני|שלישי|רביעי|חמישי|שישי|שבת)\b/g, ' ')
                    .replace(/יום\s+[א-ש]['׳"]/g, ' ')
                    .replace(/\b(שנתון|קבוצת|קבוצה)?\s*201[01]\b/g, ' ')
                    .replace(/(?:פתח\s*תקוו?ה|פ["״׳']ת)/g, ' ')
                    .replace(/אימון\s*כושר|כושר|אימון|משחק\s*ליגה|משחק|טורניר/g, ' ')
                    .replace(/\b(בשעה|שעה|במגרש|מגרש|אצטדיון|ב-)\b/g, (match) => match === 'מגרש' || match === 'אצטדיון' ? match : ' ')
                    .replace(/\b\d{1,2}[./]\d{1,2}(?:[./]\d{2,4})?\b/g, ' ')
                    .replace(/[-–—:|,]/g, ' ')
                    .replace(/\s+/g, ' ')
                    .trim();

                if (!locationText) {
                    locationText = cohortToUse === 'pt' ? 'פתח תקווה' : 'מגרש אימונים';
                }

                parsedSessions.push({
                    id: 'sess_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
                    day: dayToUse,
                    startTime,
                    endTime,
                    cohort: cohortToUse,
                    location: locationText,
                    type: activityType,
                    note: ''
                });
            }

            if (parsedSessions.length === 0) {
                showToast('לא זוהו שעות אימון בטקסט. ודאי שיש שעות כמו 17:30 או 16.', 'warning');
                return;
            }

            if (append) {
                appState.sessions = [...appState.sessions, ...parsedSessions];
            } else {
                appState.sessions = parsedSessions;
            }

            saveScheduleToCloud();
            renderAll();
            showToast(`עודכן בהצלחה! (${parsedSessions.length} מועדים נשמרו בענן)`, 'success');
        }
